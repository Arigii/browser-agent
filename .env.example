# Pick one provider and fill in only its section below.
LLM_PROVIDER=openai

# --- Anthropic (Claude) ---
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-sonnet-5

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# AGENT_MODEL=gpt-4.1

# --- Groq (OpenAI-compatible, free tier) ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# AGENT_MODEL=llama-3.1-8b-instant

# --- Google Gemini ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# AGENT_MODEL=gemini-2.5-flash

# --- Any other OpenAI-compatible endpoint (local model server, etc.) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
